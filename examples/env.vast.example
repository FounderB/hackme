# Copy to env.vast and fill before running on Vast:
#   cp examples/env.vast.example env.vast && nano env.vast
#
# Prod coordinator (CF or direct IP:18083). Worker token only — NOT node admin.
COORD_URL=http://132.243.112.100:18083
# From .secrets/hackme_coordinator_worker_token
COORD_TOKEN=

# Unique per GPU / instance, e.g. vast-2x4070tis-gpu0
WORKER_ID=vast-gpu-01
# Multi-GPU: run one process per device with GPU_DEVICE=0/1 and WORKER_ID=...-gpu0/gpu1

# 64 hex chars — generate once: ./bin/minersign -gen-seed
HACKME_MINER_ED25519_SEED_HEX=

# Pool tuning (NVIDIA remote, Blake3 SHARE_STRICT)
HACKME_GPU_BACKEND=cuda
# Floor only — coordinator adaptClaimBatch grows to ~3s × credited GH/s
BATCH_SIZE=67108864
GPU_CHUNK=67108864
SEARCH_TIMEOUT_MS=8000
HACKME_WORKER_CLAIM_TIMEOUT=90s
HACKME_WORKER_SUBMIT_TIMEOUT=120s
HACKME_CUDA_VERBOSE=0
HACKME_WORKER_SIGN_SUBMITS=1

# Hybrid fuzz off by default on matrix burns (less noise in GH/s). Enable for fleet dig.
HACKME_WORKER_HYBRID_FUZZ=0

# Session length for 01_run_pool_worker.sh (seconds) — matrix rows want ≥900–1800
RUN_SECONDS=1800
