[Unit]
Description=HackMe Node
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__SERVICE_USER__
Group=__SERVICE_USER__
WorkingDirectory=__INSTALL_DIR__
ExecStart=__INSTALL_DIR__/hackme
Restart=always
RestartSec=3
EnvironmentFile=-__INSTALL_DIR__/.env
NoNewPrivileges=true
LimitNOFILE=65535
# Binaries/scripts are root-owned; service may write data/logs/.env/.cache (Hunt).
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=__INSTALL_DIR__/data __INSTALL_DIR__/logs __INSTALL_DIR__/.env __INSTALL_DIR__/.cache
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
