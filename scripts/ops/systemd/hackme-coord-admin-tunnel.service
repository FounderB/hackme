[Unit]
Description=HackMe coordinator admin SSH tunnel (127.0.0.1:18081 → VPS loopback)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Admin settle/register needs bare coordinator :18081. Public :18083 (nginx) returns 403
# for /api/fuzz/pool/settle/outbox. Desktop ResolveCoordinatorURL prefers this loopback.
ExecStart=/usr/bin/ssh -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -N -L 127.0.0.1:18081:127.0.0.1:18081 hackme-vps
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
